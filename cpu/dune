(rule
 (alias lint)
 (deps
  lux_cpu.c
  lux_cpu.h
  ../shared/lux.h
  ../shared/lux_priv.h
  (glob_files ../utilities/stb/*.h))
 (action
  (run
   clang
   -fsyntax-only
   -I../utilities/stb
   -Weverything
   -Wextra
   -Wgcc-compat
   -Wmissing-field-initializers
   -Wno-c++98-compat
   -Wno-c++98-compat-pedantic
   -Wno-unknown-cuda-version
   -Wno-missing-prototypes
   -Wno-old-style-cast
   -Wno-unsafe-buffer-usage
   -Wno-declaration-after-statement
   -Werror
   lux_cpu.c)))
