(rule
 (alias lint)
 (deps
  cuda_helpers.c
  cuda_helpers.h)
 (action
  (run
   clang-20
   -fsyntax-only
   -isystem/usr/local/cuda/include
   -Weverything
   -Wno-c++98-compat
   -Wno-c++98-compat-pedantic
   -Wno-unknown-cuda-version
   -Wno-missing-prototypes
   -Wno-old-style-cast
   -Wno-unsafe-buffer-usage
   -Wno-declaration-after-statement
   -Werror
   cuda_helpers.c)))
